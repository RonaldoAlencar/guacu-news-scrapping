{
  "name": "guacu-news-scrapping",
  "version": "2.0.0",
  "description": "Coleta notícias locais de Mogi Guaçu e Mogi Mirim e envia para o WhatsApp via Evolution API.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:prod": "node dist/main.js",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start:dev": "node ./node_modules/nodemon/bin/nodemon.js --exec \"node -r ts-node/register\" src/main.ts",
    "services:up": "docker compose up -d --build",
    "services:down": "docker compose down",
    "database:seed": "node -r ts-node/register seed/seed.ts",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "test": "node ./node_modules/jest/bin/jest.js --coverage --verbose --forceExit",
    "scrape:once": "RUN_ONCE=true DRY_RUN=true node -r ts-node/register src/main.ts",
    "playwright:install": "node ./node_modules/playwright/cli.js install chromium"
  },
  "keywords": [
    "news",
    "scraper",
    "mogi-guacu",
    "whatsapp"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bullmq": "^5.44.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "mysql2": "^3.14.0",
    "node-cron": "^3.0.3",
    "playwright": "1.51.1"
  }
}
